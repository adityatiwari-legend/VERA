# ==============================================================================
# VERA — Environment Configuration
# Copy this file to .env and update values for your environment.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# Database Configuration (PostgreSQL with native pg driver)
# When running via Docker, vera-db runs on port 5432 internally, and 5433 on the host:
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5433/vera

# Authentication (JWT Secret for HTTP-only session cookies, min 32 chars)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production

# App URL
NEXT_PUBLIC_APP_URL=https://vera-hackcbs.adityatiwaridev.xyz

# Debug SQL Queries (optional: set to true to log direct SQL queries)
DEBUG_SQL=false

# Evidence Storage Configuration
STORAGE_PATH=storage
MAX_UPLOAD_SIZE_MB=50

# Phase 4 & 5 — Blockchain Configuration (Ethereum Sepolia / Holesky / Hardhat)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
CONTRACT_ADDRESS=0x0B306BF915C4d645ff596e518fAf3F9669b97016
NEXT_PUBLIC_CHAIN_ID=31337
BLOCKCHAIN_NETWORK=hardhat

# ------------------------------------------------------------------------------
# Gemini (pothole vision + Hinglish summaries + agent decisions)
# Get a free key: https://aistudio.google.com/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# Hisaab of the Road — Solana devnet
# Run `npm run solana:setup` to generate keypairs + airdrop, then paste the lines it prints.
# Then `npm run build:hisaab` (build) / `npm run deploy:hisaab` (deploy to devnet).
# ------------------------------------------------------------------------------
HISAAB_RPC_URL=https://api.devnet.solana.com
HISAAB_ORACLE_KEYPAIR=
HISAAB_FUNDER_KEYPAIR=
HISAAB_CONTRACTOR_PUBKEY=
NEXT_PUBLIC_HISAAB_PROGRAM_ID=AUH7tYQJFXjya5wgu9APf1Q5qDs8G9jKEEzxjA1VpxMw
SOL_INR_RATE=20000
ROUGHNESS_THRESHOLD=3.0

# ------------------------------------------------------------------------------
# Tiger Data (TimescaleDB cloud) — time-series for roughness + agent outcomes
# Free tier: https://tigerdata.com — falls back to local Postgres when unset.
# Run `npm run tiger:setup` after adding the URL.
# ------------------------------------------------------------------------------
TIGER_DATABASE_URL=

DEMO_MODE=true
ETH_INR_RATE=300000
